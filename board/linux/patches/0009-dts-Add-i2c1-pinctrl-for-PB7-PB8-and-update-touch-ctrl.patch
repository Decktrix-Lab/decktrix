From 282ce65c127b064b427484501bc87f92514691e6 Mon Sep 17 00:00:00 2001
From: Kirill Yatsenko <kiriyatsenko@gmail.com>
Date: Thu, 23 Apr 2026 10:45:10 +0200
Subject: [PATCH] dts: Add I2C1 pinctrl for PB7/PB8 and update touch controller

---
 arch/arm/boot/dts/st/stm32mp15-pinctrl.dtsi   | 19 +++++++++++++++++++
 .../boot/dts/st/stm32mp157c-dk2-jadard.dts    |  8 ++++----
 arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi     |  4 ++--
 3 files changed, 25 insertions(+), 6 deletions(-)

diff --git a/arch/arm/boot/dts/st/stm32mp15-pinctrl.dtsi b/arch/arm/boot/dts/st/stm32mp15-pinctrl.dtsi
index 058928aef..9b006c6d8 100644
--- a/arch/arm/boot/dts/st/stm32mp15-pinctrl.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp15-pinctrl.dtsi
@@ -807,6 +807,25 @@ pins {
 		};
 	};
 
+	/omit-if-no-ref/
+	i2c1_pins_d: i2c1-3 {
+		pins {
+			pinmux = <STM32_PINMUX('B', 8, AF4)>, /* I2C1_SCL */
+				 <STM32_PINMUX('B', 7, AF4)>; /* I2C1_SDA */
+			bias-disable;
+			drive-open-drain;
+			slew-rate = <0>;
+		};
+	};
+
+	/omit-if-no-ref/
+	i2c1_sleep_pins_d: i2c1-sleep-3 {
+		pins {
+			pinmux = <STM32_PINMUX('B', 8, ANALOG)>, /* I2C1_SCL */
+				 <STM32_PINMUX('B', 7, ANALOG)>; /* I2C1_SDA */
+		};
+	};
+
 	/omit-if-no-ref/
 	i2c2_pins_a: i2c2-0 {
 		pins {
diff --git a/arch/arm/boot/dts/st/stm32mp157c-dk2-jadard.dts b/arch/arm/boot/dts/st/stm32mp157c-dk2-jadard.dts
index ddfe066e7..efae594a8 100644
--- a/arch/arm/boot/dts/st/stm32mp157c-dk2-jadard.dts
+++ b/arch/arm/boot/dts/st/stm32mp157c-dk2-jadard.dts
@@ -78,14 +78,14 @@ &i2c1 {
 	jadard@68 {
 		compatible = "jadard,jdcommon";
 		reg = <0x68>;
-		interrupts = <2 IRQ_TYPE_EDGE_FALLING>;
-		interrupt-parent = <&gpiof>;
+		interrupts = <7 IRQ_TYPE_EDGE_FALLING>;
+		interrupt-parent = <&gpiog>;
 		jadard,panel-sense-nums = <30 48>;
 		jadard,panel-coords = <0 480 0 1080>;
 		jadard,panel-max-points = <10>;
 		jadard,int-is-edge = <1>;
-		jadard,irq-gpio = <&gpiof 2 GPIO_ACTIVE_HIGH>;
-		jadard,rst-gpio = <&gpiof 4 GPIO_ACTIVE_HIGH>;
+		jadard,irq-gpio = <&gpiog 7 GPIO_ACTIVE_HIGH>;
+		jadard,rst-gpio = <&gpioe 10 GPIO_ACTIVE_HIGH>;
 		status = "okay";
 	};
 };
diff --git a/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi b/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi
index 01fa4f33e..a3a45e026 100644
--- a/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi
+++ b/arch/arm/boot/dts/st/stm32mp15xx-dkx.dtsi
@@ -171,8 +171,8 @@ &hash1 {
 
 &i2c1 {
 	pinctrl-names = "default", "sleep";
-	pinctrl-0 = <&i2c1_pins_a>;
-	pinctrl-1 = <&i2c1_sleep_pins_a>;
+	pinctrl-0 = <&i2c1_pins_d>;
+	pinctrl-1 = <&i2c1_sleep_pins_d>;
 	i2c-scl-rising-time-ns = <100>;
 	i2c-scl-falling-time-ns = <7>;
 	status = "okay";
-- 
2.43.0

